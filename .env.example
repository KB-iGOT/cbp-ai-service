LOG_LEVEL="INFO"
ENVIRONMENT="local"                        # local | staging | production

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>"

# ── Google / Gemini ───────────────────────────────────────────────────────────
GOOGLE_PROJECT_ID="<gcp-project-id>"
GOOGLE_PROJECT_LOCATION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS=".creds/<service-account>.json"
GOOGLE_API_KEY="<gemini-api-key>"
GOOGLE_EMBEDDING_MODEL="gemini-embedding-2"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_DESIG_EMB_PREFIX="cbp_desig_emb"

# ── Designation Matching ──────────────────────────────────────────────────────
DESIGNATION_SIMILARITY_THRESHOLD=0.92     # 0.0 – 1.0 cosine similarity cutoff

# ── iGOT KB API ───────────────────────────────────────────────────────────────
KB_BASE_URL="https://<kb-host>"
KB_AUTH_TOKEN="Bearer <token>"

# ── JWT Auth ──────────────────────────────────────────────────────────────────
SECRET_KEY="<random-secret-key>"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440          # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Document Storage ──────────────────────────────────────────────────────────
DOCUMENT_STORAGE_TYPE=gcp                 # local | gcp
GCP_STORAGE_BUCKET=<bucket-name>
GCP_STORAGE_CREDENTIALS=".creds/<storage-service-account>.json"

# ── Notifications ─────────────────────────────────────────────────────────────
ENABLE_EMAIL_NOTIFICATION=False
NOTIFICATION_BASE_URL="https://<notification-service-host>"
SPV_PORTAL_URL="https://<spv-portal-host>"
MDO_PORTAL_URL="https://<mdo-portal-host>"

# ── Bhashini Translation ──────────────────────────────────────────────────────
BHASHINI_USER_ID=<bhashini-user-id>
BHASHINI_API_KEY=<bhashini-api-key>
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_CONFIG_API_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_SUPPORTED_LANGUAGES=en,hi,te,kn,mr,ta,gu,ml,or,pa,bn,as


# ==========================================================================
# Course-recommendation retrieval tuning (feature flags)
# All optional; the defaults below are what the code uses if unset.
# ==========================================================================

# Hybrid retrieval = dense (semantic) + lexical (Postgres full-text) fused
# via Reciprocal Rank Fusion. Keep on for keyword + semantic matching.
HYBRID_SEARCH_ENABLED="true"

# Gently prefer Communication / GenAI courses among relevant results.
COMM_GENAI_BOOST_ENABLED="true"

# Boost courses whose competencies overlap the role's required competencies.
COMPETENCY_BOOST_ENABLED="true"

# --- Phase 2: content-embedding rerank (ON by default) --------------------
# Re-ranks the hybrid candidates against course CONTENT embeddings before the
# LLM stage, then narrows to CONTENT_RERANK_TOP_N. Set to "false" to disable
# (recommended in environments without the content_embeddings table).
#
# REQUIRES a `public.content_embeddings` table. It is NOT created by the app's
# migrations -- restore/populate it separately (e.g. from the content-embeddings
# dump, or your own content-embedding pipeline) before enabling this flag.
#
# Needs the pgvector extension:   CREATE EXTENSION IF NOT EXISTS vector;
#
# The rerank query uses `path` + `embedding`; minimal schema that makes it work:
#     CREATE TABLE public.content_embeddings (
#         path       text,            -- "<course_id>" or "<course_id>/<resource_id>#chunkN"
#         embedding  vector(768)      -- same model/space as course_metadata_v2.embedding
#     );
# Notes:
#   - JOIN KEY is split_part(path,'/',1) (the parent course id), NOT `identifier`.
#     `identifier` holds the per-chunk/resource id and matches almost no course.
#   - Content is CHUNKED: a course has many rows (one per content chunk). The
#     rerank takes MAX(1 - cosine_distance) over all of a course's chunks.
#   - Optional speedup for a large table:
#     CREATE INDEX ON public.content_embeddings (split_part(path, '/', 1));
#   - The full source dump also carries: id, identifier, name, content, description,
#     mime_type, artifact_url, source, purpose, status, content_type,
#     embedding_status, created_at, content_start, content_end -- not required here.
#   - If the table is absent, the app logs a warning (per request) and falls back
#     to hybrid order, so it stays runnable -- but disable the flag in that case.
CONTENT_RERANK_ENABLED="true"
CONTENT_RERANK_TOP_N="40"           # candidates passed to the LLM after rerank
CONTENT_RERANK_WEIGHT="0.5"         # blend: (1-w)*hybrid + w*content  (0..1)