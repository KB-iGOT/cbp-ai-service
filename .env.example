# ==========================================================================
# CBP AI Service - example environment file
# Copy to `.env` and fill in real values. DO NOT commit your real .env.
# ==========================================================================

# --- App ------------------------------------------------------------------
ENVIRONMENT="local"                 # local | staging | production
LOG_LEVEL="INFO"
APP_ROOT_PATH="/cbp-tpc-ai"
SECRET_KEY="change-me"              # JWT signing secret

# --- Database -------------------------------------------------------------
# IMPORTANT: the app uses async SQLAlchemy, so the driver MUST be asyncpg.
# Use the postgresql+asyncpg:// scheme (NOT plain postgresql://).
DATABASE_URL="postgresql+asyncpg://USER:PASSWORD@localhost:5432/ai_cbp"

# --- Google Vertex AI (embeddings + Gemini) -------------------------------
GOOGLE_PROJECT_ID="your-gcp-project-id"
GOOGLE_PROJECT_LOCATION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS="/abs/path/to/service-account.json"
EMBEDDING_MODEL_NAME="text-multilingual-embedding-002"

# --- iGOT Karmayogi (KB) API ----------------------------------------------
KB_BASE_URL="https://example.org"
KB_AUTH_TOKEN="your-kb-token"

# --- Document storage -----------------------------------------------------
DOCUMENT_STORAGE_TYPE="local"       # local | gcp
GCP_STORAGE_BUCKET=""
GCP_STORAGE_PREFIX="documents"
GCP_STORAGE_CREDENTIALS=""           # path to GCS service-account json (if gcp)

# --- Bhashini (translation) ----------------------------------------------
BHASHINI_USER_ID=""
BHASHINI_API_KEY=""
BHASHINI_PIPELINE_ID=""
BHASHINI_CONFIG_API_URL=""
BHASHINI_SUPPORTED_LANGUAGES="en,hi"

# --- File upload limits (bytes) -------------------------------------------
PDF_MAX_FILE_SIZE=52428800
CSV_MAX_FILE_SIZE=10485760

# ==========================================================================
# Course-recommendation retrieval tuning (feature flags)
# All optional; the defaults below are what the code uses if unset.
# ==========================================================================

# Hybrid retrieval = dense (semantic) + lexical (Postgres full-text) fused
# via Reciprocal Rank Fusion. Keep on for keyword + semantic matching.
HYBRID_SEARCH_ENABLED="true"

# Gently prefer Communication / GenAI courses among relevant results.
COMM_GENAI_BOOST_ENABLED="true"

# Boost courses whose competencies overlap the role's required competencies.
COMPETENCY_BOOST_ENABLED="true"

# --- Phase 2: content-embedding rerank (OPT-IN, off by default) -----------
# When "true", re-ranks the hybrid candidates against course CONTENT embeddings
# before the LLM stage, then narrows to CONTENT_RERANK_TOP_N.
#
# REQUIRES a `public.content_embeddings` table (NOT created by migrations):
#     identifier  text         -- course id; joins to course_metadata_v2.identifier
#     embedding   vector(768)  -- same embedding model/space as the course vectors
# Restore / populate it separately before enabling. If the table is absent the
# app logs a warning and falls back to hybrid order, so it stays runnable.
CONTENT_RERANK_ENABLED="false"
CONTENT_RERANK_TOP_N="40"           # candidates passed to the LLM after rerank
CONTENT_RERANK_WEIGHT="0.5"         # blend: (1-w)*hybrid + w*content  (0..1)
