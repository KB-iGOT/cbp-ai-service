# ==========================================================================
# CBP AI Service - example environment file
# Copy to `.env` and fill in real values. DO NOT commit your real .env.
# ==========================================================================

# --- App ------------------------------------------------------------------
LOG_LEVEL="INFO"
ENVIRONMENT="local"                        # local | staging | production

# --- Database -------------------------------------------------------------
# IMPORTANT: async SQLAlchemy -> driver MUST be asyncpg (postgresql+asyncpg://).
DATABASE_URL="postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>"

# --- Google / Gemini (embeddings + Gemini models) -------------------------
GOOGLE_PROJECT_ID="<gcp-project-id>"
GOOGLE_PROJECT_LOCATION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS=".creds/<service-account>.json"
GOOGLE_API_KEY="<gemini-api-key>"                  # Developer-API key for gemini-embedding-2
GOOGLE_EMBEDDING_MODEL="gemini-embedding-2"        # main course/query embedding
EMBEDDING_OUTPUT_DIMENSIONALITY=1536               # course_metadata_v3.embedding is vector(1536)
# Legacy embedding model used ONLY by content_rerank (matches content_embeddings' 768-dim space)
CONTENT_EMBEDDING_MODEL="text-multilingual-embedding-002"

# --- Redis ----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_DESIG_EMB_PREFIX="cbp_desig_emb"

# --- Designation matching -------------------------------------------------
DESIGNATION_SIMILARITY_THRESHOLD=0.92      # 0.0 - 1.0 cosine similarity cutoff

# --- iGOT Karmayogi (KB) API ----------------------------------------------
KB_BASE_URL="https://<kb-host>"
KB_AUTH_TOKEN="Bearer <token>"

# --- JWT Auth -------------------------------------------------------------
SECRET_KEY="<random-secret-key>"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440           # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Document storage -----------------------------------------------------
DOCUMENT_STORAGE_TYPE=gcp                   # local | gcp
GCP_STORAGE_BUCKET=<bucket-name>
GCP_STORAGE_PREFIX="documents"
GCP_STORAGE_CREDENTIALS=".creds/<storage-service-account>.json"

# --- Notifications --------------------------------------------------------
ENABLE_EMAIL_NOTIFICATION=False
NOTIFICATION_BASE_URL="https://<notification-service-host>"
SPV_PORTAL_URL="https://<spv-portal-host>"
MDO_PORTAL_URL="https://<mdo-portal-host>"

# --- Bhashini (translation) -----------------------------------------------
BHASHINI_USER_ID=<bhashini-user-id>
BHASHINI_API_KEY=<bhashini-api-key>
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_CONFIG_API_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_SUPPORTED_LANGUAGES=en,hi,te,kn,mr,ta,gu,ml,or,pa,bn,as

# --- File upload limits (bytes) -------------------------------------------
PDF_MAX_FILE_SIZE=52428800
CSV_MAX_FILE_SIZE=10485760

# ==========================================================================
# Course-recommendation retrieval tuning (feature flags)
# All optional; the defaults below are what the code uses if unset.
# ==========================================================================

# Hybrid retrieval = dense (semantic: gemini-embedding-2 @1536 over
# course_metadata_v3) + lexical (Postgres full-text) fused via Reciprocal Rank
# Fusion. Keep on for keyword + semantic matching.
HYBRID_SEARCH_ENABLED="true"

# Gently prefer Communication / GenAI courses among relevant results.
COMM_GENAI_BOOST_ENABLED="true"

# Boost courses whose competencies overlap the role's required competencies.
COMPETENCY_BOOST_ENABLED="true"

# --- Phase 2: content-embedding rerank (ON by default) --------------------
# Re-ranks the hybrid candidates against course CONTENT embeddings before the
# LLM stage, then narrows to CONTENT_RERANK_TOP_N. Set "false" to disable
# (recommended where the content_embeddings table is absent).
#
# DIMENSION NOTE: content_embeddings is 768-dim, built with CONTENT_EMBEDDING_MODEL
# (text-multilingual-embedding-002) -- a DIFFERENT vector space from the 1536-dim
# gemini-embedding-2 vectors in course_metadata_v3. content_rerank embeds the query
# separately with CONTENT_EMBEDDING_MODEL; it does NOT reuse the 1536-dim main vector.
#
# REQUIRES a `public.content_embeddings` table (NOT created by migrations --
# restore/populate it separately). Needs pgvector: CREATE EXTENSION IF NOT EXISTS vector;
# Minimal schema:
#     CREATE TABLE public.content_embeddings (
#         path       text,            -- "<course_id>" or "<course_id>/<resource_id>#chunkN"
#         embedding  vector(768)      -- legacy text-multilingual-embedding-002 space
#     );
# Notes:
#   - JOIN KEY is split_part(path,'/',1) (the parent course id), NOT `identifier`.
#   - Content is CHUNKED; rerank takes MAX(1 - cosine_distance) over a course's chunks.
#   - Optional speedup: CREATE INDEX ON public.content_embeddings (split_part(path,'/',1));
#   - If the table is absent, the app logs a warning and falls back to hybrid order.
CONTENT_RERANK_ENABLED="true"
CONTENT_RERANK_TOP_N="40"           # candidates passed to the LLM after rerank
CONTENT_RERANK_WEIGHT="0.5"         # blend: (1-w)*hybrid + w*content  (0..1)
